---
import ClientShowcase from "../components/ClientShowcase.astro";

const features = [
  ["Goal-to-route planning", "Turn manufacturing intent into explicit process, machine, material, split, combine, and instruction decisions."],
  ["Release gates", "Validate a plan before instructions can reach a machine or operator workflow."],
  ["Live plan events", "Keep UIs, automations, and operators aligned through one authenticated event contract."],
  ["Polyglot automation", "Use the same plan operations from native, browser, mobile, BEAM, JVM, systems, and scripting runtimes."],
  ["Credential isolation", "Keep bearer tokens at the transport edge and out of synchronized plan documents."],
  ["Outcome learning", "Feed real fabrication results back into planning without rewriting every client."],
];

const samples = [
  {
    id: "python", label: "Python", file: "plan.py",
    code: `from daedalus import DaedalusClient

client = DaedalusClient(
    base_url="https://api.daedalus-fab.com",
    token="<supabase-access-token>",
)
plan = client.create_plan(
    title="titanium bracket",
    goal="print an AS9100-traceable bracket for the fixture",
    process_family="additive",
)
print(plan.id, plan.status)`,
    note: "The Python package wraps the same authenticated plan contract as the native clients.",
  },
  {
    id: "dart", label: "Dart / Flutter", file: "plan.dart",
    code: `final client = DaedalusClient(
  baseUrl: 'https://api.daedalus-fab.com',
  token: '<supabase-access-token>',
);
final plan = await client.createPlan(
  title: 'titanium bracket',
  goal: 'print an AS9100-traceable bracket for the fixture',
  processFamily: 'additive',
);
await for (final event in client.planEvents(plan.id)) {
  print('[36m${event.kind}[0m');
}`,
    note: "Dart supports the plan-event stream used by Flutter applications.",
  },
  {
    id: "typescript", label: "TypeScript", file: "plan.ts",
    code: `const client = new DaedalusClient({
  baseUrl: "https://api.daedalus-fab.com",
  token: "<supabase-access-token>",
});
const plan = await client.createPlan({
  title: "titanium bracket",
  goal: "print an AS9100-traceable bracket for the fixture",
  processFamily: "additive",
});
console.log(plan.id, plan.status);`,
    note: "The TypeScript package is a thin HTTP wrapper over the machine-readable operation contract.",
  },
  {
    id: "rust", label: "Rust", file: "plan.rs",
    code: `let client = DaedalusClient::from_env()?;
let plan = client
    .create_plan(
        "titanium bracket",
        "print an AS9100-traceable bracket for the fixture",
        Some("additive"),
    )
    .await?;
println!("{} {}", plan.id, plan.status);`,
    note: "Native clients read credentials without serializing them into plan data.",
  },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Fabrication planning from manufacturing intent to released, reviewable instructions." />
  <meta name="theme-color" content="#111827" />
  <title>Daedalus — manufacturing intelligence</title>
</head>
<body>
  <header>
    <a class="brand" href="/"><b>D</b><span>Daedalus</span></a>
    <nav><a href="#platform">Platform</a><a href="#clients">Clients</a><a href="https://github.com/daedalus-fab">GitHub ↗</a></nav>
  </header>
  <main>
    <section class="hero">
      <div>
        <p class="eyebrow">Fabrication intelligence · Open platform</p>
        <h1>Build the route before you <em>build the part.</em></h1>
        <p class="lede">Daedalus turns manufacturing intent into reviewable plans, process choices, machine-ready instructions, and live events—without hiding the decisions that matter.</p>
        <div class="actions"><a class="primary" href="https://github.com/daedalus-fab">Explore the platform ↗</a><a href="#clients">See client code</a></div>
        <ul><li>HTTP-first SDKs</li><li>TLS-enforced auth</li><li>Additive · subtractive · hybrid</li></ul>
      </div>
      <div class="visual" aria-label="A release-ready fabrication plan">
        <span class="grid"></span><i class="orbit one"></i><i class="orbit two"></i>
        <div class="core"><small>PLAN STATE</small><strong>release-ready</strong><span>Every decision stays inspectable.</span></div>
        <div class="chip a">PROCESS <b>additive</b></div><div class="chip b">PREFLIGHT <b>passed</b></div>
        <div class="chip c">EVENTS <b>live</b></div><div class="chip d">TRACEABILITY <b>on</b></div>
      </div>
    </section>

    <section class="metrics"><div><b>14</b><span>SDK slices</span></div><div><b>1</b><span>shared API contract</span></div><div><b>HTTPS</b><span>outside localhost</span></div><div><b>WebSocket</b><span>plan events</span></div></section>

    <section id="platform" class="platform">
      <p class="eyebrow">From goal to route</p>
      <h2>A manufacturing control plane that explains itself.</h2>
      <p class="intro">Planning, geometry, process selection, safety gates, and event delivery remain separate, testable layers. Automate aggressively while preserving the evidence needed for human release.</p>
      <div class="features">{features.map(([title, body], index) => <article><small>{String(index + 1).padStart(2, "0")}</small><h3>{title}</h3><p>{body}</p></article>)}</div>
    </section>

    <div id="clients"><ClientShowcase title="Drive fabrication plans from the language already in your stack." description="Every package wraps the same health, plan CRUD, creation, and event contract. Choose a maintained example, copy it, then inspect the complete matrix in daedalus-clients." source="https://github.com/daedalus-fab/daedalus-clients" samples={samples} /></div>

    <section class="flow"><div><p class="eyebrow">Contract-first</p><h2>One plan boundary, many runtimes.</h2></div><div class="steps"><span>intent</span><b>→</b><span>plan API</span><b>→</b><span>preflight</span><b>→</b><span>events</span><b>→</b><span>release</span></div><p>SDKs carry authentication and typed requests. They do not reinterpret manufacturing policy.</p></section>

    <section class="closing"><p class="eyebrow">Make the next part explainable</p><h2>Move from fabrication goals to released instructions.</h2><p>Explore the server, geometry engine, client matrix, and operator-facing applications.</p><a href="https://github.com/daedalus-fab">Open the organization ↗</a></section>
  </main>
  <footer><span>© 2026 Daedalus</span><a href="https://github.com/daedalus-fab/daedalus-clients">Client packages</a></footer>
</body>
</html>

<style is:global>
:root{--accent:#b45309;--accent2:#ef4444;--ink:#0b1020;--muted:#5f6b7c;--paper:#f7f9fc;color-scheme:light}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;overflow-x:hidden;background:linear-gradient(180deg,#fff7ed,var(--paper) 34rem);color:var(--ink);font:16px/1.6 Inter,ui-sans-serif,system-ui,sans-serif}a{color:inherit}header,main,footer{width:min(1180px,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 0}.brand{display:flex;gap:.65rem;align-items:center;font-weight:900;text-decoration:none}.brand b{display:grid;width:2.2rem;aspect-ratio:1;place-items:center;border-radius:.7rem;background:var(--ink);color:white}nav{display:flex;gap:1.3rem;font-size:.88rem;font-weight:750}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,7vw,7rem);align-items:center;min-height:720px;padding:5rem 0}.eyebrow{margin:0;color:var(--accent);font:800 .72rem/1 ui-monospace,monospace;letter-spacing:.18em;text-transform:uppercase}h1{max-width:12ch;margin:.8rem 0 1.3rem;font-size:clamp(3.4rem,8vw,7rem);line-height:.86;letter-spacing:-.075em}h1 em{background:linear-gradient(120deg,var(--accent),var(--accent2));background-clip:text;color:transparent;font-style:normal}.lede,.intro{max-width:45rem;color:var(--muted);font-size:1.12rem}.actions{display:flex;gap:.75rem;flex-wrap:wrap;margin:2rem 0}.actions a,.closing a{padding:.75rem 1.05rem;border:1px solid #0f172a18;border-radius:.8rem;font-weight:800;text-decoration:none}.actions .primary{background:var(--ink);color:white}.hero ul{display:flex;flex-wrap:wrap;gap:1rem;margin:0;padding:0;color:var(--muted);font-size:.82rem;list-style:none}.hero li:before{content:'◆';margin-right:.4rem;color:var(--accent)}.visual{position:relative;min-height:31rem;overflow:hidden;border-radius:2rem;background:radial-gradient(circle at 50% 48%,#b4530940,transparent 35%),linear-gradient(145deg,#080f1e,#151f34);box-shadow:0 35px 90px #0f172a42}.grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff0d 1px,transparent 1px),linear-gradient(90deg,#ffffff0d 1px,transparent 1px);background-size:2.3rem 2.3rem}.orbit{position:absolute;inset:50% auto auto 50%;border:1px solid #ffffff26;border-radius:50%;transform:translate(-50%,-50%)}.orbit.one{width:18rem;aspect-ratio:1}.orbit.two{width:27rem;aspect-ratio:1}.core,.chip{position:absolute;border:1px solid #ffffff20;background:#0f172bcc;color:white;backdrop-filter:blur(14px)}.core{top:50%;left:50%;display:grid;width:13.5rem;padding:1.2rem;border-radius:1.2rem;transform:translate(-50%,-50%)}.core small,.chip{font:700 .65rem/1.4 ui-monospace,monospace;letter-spacing:.1em}.core strong{margin:.4rem 0;font-size:1.35rem}.core span{color:#94a3b8;font-size:.8rem}.chip{display:grid;min-width:8rem;padding:.75rem;border-radius:.9rem;color:#94a3b8}.chip b{color:white}.chip.a{top:11%;left:8%}.chip.b{top:15%;right:7%}.chip.c{bottom:12%;left:7%}.chip.d{right:8%;bottom:9%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid #0f172a16;border-radius:1.2rem;background:#ffffffb8;box-shadow:0 20px 55px #0f172a10}.metrics div{display:grid;padding:1.2rem}.metrics div+div{border-left:1px solid #0f172a16}.metrics b{font-size:1.35rem}.metrics span{color:var(--muted);font-size:.78rem}.platform{padding:8rem 0}.platform h2,.flow h2,.closing h2{max-width:15ch;margin:.6rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem);line-height:.94;letter-spacing:-.06em}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.features article{min-height:15rem;padding:1.3rem;border:1px solid #0f172a14;border-radius:1.2rem;background:#ffffffc4}.features small{color:var(--accent);font:800 .7rem/1 ui-monospace,monospace}.features h3{margin:2.4rem 0 .6rem;font-size:1.25rem}.features p{color:var(--muted)}.flow{display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem 4rem;align-items:end;margin:9rem 0;padding:clamp(2rem,6vw,5rem);border-radius:1.7rem;background:#08101f;color:white}.flow .eyebrow{color:#fdba74}.flow>p{grid-column:2;margin:0;color:#94a3b8}.steps{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap}.steps span{padding:.65rem .8rem;border:1px solid #ffffff20;border-radius:.65rem;background:#ffffff0b;font:650 .75rem/1 ui-monospace,monospace}.steps b{color:#fb923c}.closing{margin-bottom:2rem;padding:clamp(2rem,7vw,6rem);border-radius:2rem;background:linear-gradient(125deg,var(--accent),var(--accent2));color:white}.closing .eyebrow{color:#ffffffc4}.closing p{max-width:46rem}.closing a{display:inline-block;margin-top:1rem;background:white;color:var(--ink)}footer{display:flex;justify-content:flex-end;gap:1.5rem;padding:1.5rem 0 3rem;color:var(--muted);font-size:.8rem}footer span{margin-right:auto}footer a{text-decoration:none}@media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto}.features{grid-template-columns:1fr 1fr}.flow{grid-template-columns:1fr}.flow>p{grid-column:1}}@media(max-width:650px){nav a:not(:last-child){display:none}.visual{min-height:25rem}.metrics{grid-template-columns:1fr 1fr}.metrics div:nth-child(n+3){border-top:1px solid #0f172a16}.features{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
